{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/reminders?type=wednesday",
      "schedule": "30 4 * * 3"
    },
    {
      "path": "/api/cron/reminders?type=thursday",
      "schedule": "30 3 * * 4"
    }
  ]
}
